1263   
1264   
1265  ** SUM UP SOME DATA
1266   
1267  parameters  VALPRODUCTS(I, N)           "value of dairy product N produced in region I (or exported to US regions for ROW)"
1268              QTYMILKUSE(DOMJ)            "quantity of milk used (received) in region DOMJ"
1269              VALMILKUSE(DOMJ)            "value of milk used in region DOMJ"
1270              MILKPRICE(DOMI)             "price of milk in region DOMI"
1271              VALMILKPROD(DOMI)           "value of milk produced in region DOMI"
1272              QTYMILKPROD(DOMI)           "quantity of milk produced in region DOMI (used only to compute aggregate milk production and price effects)"
1273              PC                          "total value of dairy consumption (including foreign)"
1274              ;
1275   
1276  VALPRODUCTS(I, N) = sum(J, VALPRODSHIP(I, J, N)) ;
1277  QTYMILKUSE(DOMJ) = sum(DOMI, QTYMILKSHIP(DOMI, DOMJ)) ;
1278  VALMILKUSE(DOMJ) = sum((N, K), VALCOMPUSE(DOMJ, N, K)) ;
1279  MILKPRICE(DOMI) = VALMILKUSE(DOMI) / QTYMILKUSE(DOMI) ;
1280  VALMILKPROD(DOMI) = sum(DOMJ, QTYMILKSHIP(DOMI, DOMJ) * MILKPRICE(DOMJ)) ;
1281  QTYMILKPROD(DOMI) = VALMILKPROD(DOMI)  / MILKPRICE(DOMI) ;
1282  PC = sum((I, N), VALPRODUCTS(I,N)) ;
1283   
1284   
1285  ** CALCULATE PARAMETERS DEFINED BY THE DATA
1286   
1287  parameters  A0                          "share of domestic production in total dairy product revenue"
1288              A1(DOMI)                    "share of region DOMI in value of domestic dairy production"
1289              A2(I,N)                     "share of product N in value of dairy production in region DOMI (or in US exports for ROW)"
1290              A3(I,J,N)                   "share of region I production of N shipped to J"
1291              MU2(DOMI, DOMJ)             "share of milk used in region DOMJ shipped from region DOMI"
1292              THETA1(DOMI)                "overall cost share of milk in dairy products made in region DOMI"
1293              THETA2(DOMI, K)             "share of component K in total milk value in region DOMI"
1294              THETA3(DOMI, N, K)          "share of product N in value of component K in region DOMI"
1295              CHI(DOMI, N, K)             "share of product N in volume of component K in region DOMI"
1296              RHO1(DOMI)                  "share of region DOMI in value of domestic crop production"
1297              RHO2(DOMI, L)               "share of crop L in region i value of crop production"
1298              XI1(I)                      "share of total feed crop value used in region I"
1299              XI2(DOMI, SUBL)             "share of crop SUBL in value of region DOMI's feed crop use"
1300              PHI0                        "feed crop share of the milk dollar"
1301              VARPHI1(DOMI)               "land share of the crop dollar in region DOMI"
1302              PI(DOMI,L)                  "share of crop L in region DOMI's total cropland"
1303              ;
1304   
1305  A0 = sum((DOMJ, N), VALPRODUCTS(DOMJ, N)) / sum((I, N), VALPRODUCTS(I, N))  ;
1306   
1307  A1(DOMI) = sum(N, VALPRODUCTS(DOMI, N)) / sum((DOMJ, N), VALPRODUCTS(DOMJ, N)) ;
1308   
1309  A2(I, N) = VALPRODUCTS(I, N) / sum(O, VALPRODUCTS(I, O)) ;
1310   
1311  A3(I, J, N)$(VALPRODUCTS(I, N) > 0) = VALPRODSHIP(I, J, N) / VALPRODUCTS(I, N) ;
1312   
1313  MU2(DOMI, DOMJ) = QTYMILKSHIP(DOMI, DOMJ) / QTYMILKUSE(DOMJ) ;
1314   
1315  THETA1(DOMI) = VALMILKUSE(DOMI) / sum(N, VALPRODUCTS(DOMI, N)) ;
1316   
1317  THETA2(DOMI, K) = sum(N, VALCOMPUSE(DOMI, N, K)) / sum((N, S), VALCOMPUSE(DOMI, N, S)) ;
1318   
1319  THETA3(DOMI, N, K) = VALCOMPUSE(DOMI, N, K) / sum(O, VALCOMPUSE(DOMI, O, K)) ;
1320   
1321  CHI(DOMI, N, K) = QTYCOMPUSE(DOMI, N, K) / sum(O, QTYCOMPUSE(DOMI, O, K)) ;
1322   
1323  RHO1(DOMI) = sum(L, VALCROPPROD(DOMI, L)) / sum((DOMJ, L), VALCROPPROD(DOMJ, L)) ;
1324   
1325  RHO2(DOMI, L) = VALCROPPROD(DOMI, L) / sum(M, VALCROPPROD(DOMI, M)) ;
1326   
1327  XI1(DOMI) = (VALCROPPROD(DOMI,"silage") + sum(SUBSUBL, VALCROPUSE(DOMI, SUBSUBL))) / sum((DOMJ, SUBL), VALCROPPROD(DOMJ, SUBL)) ;
1328   
1329  XI2(DOMI, SUBSUBL) = VALCROPUSE(DOMI, SUBSUBL) / (VALCROPPROD(DOMI,"silage") + sum(SUBSUBM, VALCROPUSE(DOMI, SUBSUBM))) ;
1330  XI2(DOMI, "silage") = VALCROPPROD(DOMI,"silage") / (VALCROPPROD(DOMI,"silage") + sum(SUBSUBL, VALCROPUSE(DOMI, SUBSUBL))) ;
1331   
1332  PHI0 = sum(DOMI, VALCROPPROD(DOMI,"silage") + sum(SUBSUBL, VALCROPUSE(DOMI, SUBSUBL))) / sum(DOMI, VALMILKUSE(DOMI)) ;
1333   
1334  VARPHI1(DOMI) = CROPLANDRENT(DOMI)*sum(L, CROPACRES(DOMI,L)) / sum(L, VALCROPPROD(DOMI, L)) ;
1335   
1336  PI(DOMI, L) = CROPACRES(DOMI, L) / sum(M, CROPACRES(DOMI, M)) ;
1337   
1338   
1339  ** CALCULATE PARAMETERS DEDUCED FROM OTHER PARAMETERS
1340   
1341  parameters  B1(J)                   "expenditure share of region J in total dairy consumption"
1342              B2(J, N)                "expenditure share of dairy product N in region J"
1343              B3(I, J, N)             "budget share of product N from region I in region J"
1344              PSI2(DOMI, N)           "cost share of milk components for product N in region DOMI"
1345              C3(DOMI, N, K)          "cost share of component K for product N in region DOMI"
1346              PSI                     "milk share of domestic dairy product dollar"
1347              MU1(DOMI)               "share of region DOMI in value of domestic milk production"
1348              A(DOMI,DOMJ)            "share of region DOMI milk value shipped to region DOMJ"
1349              RHO0                    "share of non-feed crop in value of total crop production"
1350              PHI1(DOMI)              "feed crop share of the milk dollar in region DOMI"
1351              VARPHI2(DOMI,L)         "land share of the crop dollar for crop L in region DOMI"
1352              DELTA(DOMI, N, K)       "policy distortion parameter"
1353              ;
1354   
1355  B1(J) = A0 * sum(DOMI, A1(DOMI) * sum(N, A2(DOMI, N) * A3(DOMI, J, N))) + (1 - A0) * sum(N, A2("ROW", N) * A3("ROW", J, N)) ;
1356   
1357  B2(J, N)$(B1(J) > 0) = [A0 * sum(DOMI, A1(DOMI) * A2(DOMI, N) * A3(DOMI, J, N)) + (1 - A0) * A2("ROW", N) * A3("ROW", J, N)] / B1(J) ;
1358   
1359  B3(DOMI, J, N)$(B2(J, N) > 0) = A0 * A1(DOMI) * A2(DOMI, N) * A3(DOMI, J, N) / (B1(J) * B2(J, N)) ;
1360  B3("ROW", J, N)$(B2(J, N) > 0) = (1 - A0) * A2("ROW", N) * A3("ROW", J, N) / (B1(J) * B2(J, N)) ;
1361   
1362  PSI2(DOMI, N) = THETA1(DOMI) / A2(DOMI, N) * sum(K, THETA2(DOMI, K) * THETA3(DOMI, N, K)) ;
1363   
1364  C3(DOMI, N, K) = THETA1(DOMI) * THETA2(DOMI, K) * THETA3(DOMI, N, K) / (A2(DOMI, N) * PSI2(DOMI, N)) ;
1365   
1366  PSI = sum(DOMI, A1(DOMI) * THETA1(DOMI)) ;
1367   
1368  MU1(DOMI) = sum(DOMJ, A1(DOMJ) * THETA1(DOMJ) * MU2(DOMI, DOMJ)) / PSI ;
1369   
1370  A(DOMI, DOMJ) = A1(DOMJ) * THETA1(DOMJ) * MU2(DOMI, DOMJ) / (PSI * MU1(DOMI)) ;
1371   
1372  RHO0 = sum(DOMI, RHO2(DOMI, "Other-Crops") * RHO1(DOMI)) ;
1373   
1374  XI1("ROW") = 1 -sum(DOMI, XI1(DOMI)) ;
1375   
1376  PHI1(DOMI) = XI1(DOMI) * PHI0 / (MU1(DOMI) * (1 - XI1("ROW"))) ;
1377   
1378  VARPHI2(DOMI, L)$(RHO2(DOMI, L) > 0) = PI(DOMI, L) * VARPHI1(DOMI) / RHO2(DOMI, L) ;
1379   
1380  DELTA(DOMI, N, K) = THETA3(DOMI, N, K) / THETA3(DOMI, "Butter-Powder", K) * CHI(DOMI, "Butter-Powder", K) / CHI(DOMI, N, K) ;
1381   
1382   
1383  ****************************************************************************
1384  ***************************COUNTERFACTUAL MODELS****************************
1385  ****************************************************************************
1386   
1387  **EXOGENOUS CHANGES FOR COUNTERFACTUAL MODELS
1388   
1389  parameters  DELTAHAT(DOMI, N, K)      "hat value of policy distortion parameter (for MODEL FMMO)"
1390              TAU(DOMI, DOMJ)           "relative change in farm milk trade cost (for MODEL MILKTRADECOST)"
1391              VINDEXEX(DOMI,N)          "exogenous relative change in price index for components used in product N in region DOMI"
1392              ;
1393   
1394  **VARIABLES AND POSITIVE VARIABLES
1395   
1396  variables   C(I, DOMJ, N)             "relative change in region DOMJ demand for product N from origin I"
1397              C0(DOMI, N)               "relative change in foreign demand for product N from origin DOMI"
1398              PINDEX1(DOMJ)             "relative change in dairy product price index in region DOMJ"
1399              PINDEX2(DOMJ, N)          "relative change in price of product N in region DOMJ"
1400              PINDEX10                  "relative change in foreign price index for dairy products"
1401              PINDEX20(SUBN)            "relative change in foreign price of product SUBN"
1402              Q(DOMI, N)                "relative change in production of product N in region DOMI"
1403              Z(DOMI, N, K)             "relative change in derived demand for component K used in product N in region DOMI"
1404              VINDEX(DOMI, N)           "relative change in price index for components used in product N in region DOMI"
1405              V(DOMI, K)                "relative change in price of component K in region DOMI"
1406              P(I, N)                   "relative change in producer price of product N in region I"
1407              MQUANT(DOMI)              "relative change in milk production in region DOMI"
1408              MSHIP(DOMI, DOMJ)         "relative change in quantity of milk used in region DOMJ that comes from region DOMI"
1409              MPRICE(DOMI)              "relative change in milk price in region DOMI"
1410              MMPRICE(DOMI)             "relative change in processor milk price in region DOMI (for MODEL QUOTAREG)"
1411              WINDEX1(DOMI)             "relative change in feed crop price index in region DOMI"
1412              R(DOMI, L)                "relative change in land rent for crop L in region DOMI"
1413              W(DOMI, L)                "relative change in producer price of crop L in region DOMI"
1414              Y(DOMI, L)                "relative change in production of crop L in region DOMI"
1415              OBJ                       "constant objective variable for optimization algorithm"
1416              DELTAHATOPT(DOMI, N, K)   "wedges as choice variables"
1417              DOMCONSSURP               "domestic consumer surplus (for MODELS BETTERWEDGESREG and QUOTAREG)"
1418              TRANSFER
1419              ;
1420   
1421  **EQUATIONS
1422   
1423  equations   EQ1(I, DOMJ, N)         "domestic consumer demand in region DOMJ for dairy products from region I"
1424              EQ2(DOMI, SUBN)         "foreign consumer demand for US regional dairy products"
1425              EQ3(DOMJ)               "definition of region DOMJ dairy product price index"
1426              EQ4(DOMJ, N)            "definition of region DOMJ price index for product N"
1427              EQ5                     "definition of foreign dairy product price index"
1428              EQ6(SUBN)               "definition of foreign price index for product N"
1429              EQ7(DOMI, N)            "dairy product market clearing"
1430              EQ8(DOMI, N, K)         "derived demand for component K used in product N in region DOMI"
1431              EQ8OPT(DOMI, N, K)      "EQ8 with endogenous deltahat (for for MODELS BETTERWEDGESREG AND BETTERSUPPORT)"
1432              EQ9(DOMI, N)            "definition of component price index for product N in region DOMI"
1433              EQ9OPT(DOMI, N)         "EQ9 with endogenous deltahat (for MODELS BETTERWEDGESREG AND BETTERSUPPORT)"
1434              EQ10(DOMI, N)           "dairy product price relationship"
1435              EQ10EX(DOMI, N)         "EQ10 with exogenous VINDEX (for MODEL COMPDEMAND)"
1436              EQ11(DOMI)              "milk market clearing"
1437              EQ11TRC(DOMI)           "EQ11 for MODEL MILKTRADECOST"
1438              EQ12(DOMI, K)           "component market clearing"
1439              EQ13(DOMI)              "milk value and component value relationship"
1440              EQ13OPT(DOMI)           "EQ13 with endogenous deltahat (for for MODELS BETTERWEDGESREG and BETTERSUPPORT)"
1441              EQ13QU(DOMI)            "milk processing value and component value relationship for MODELS QUOTAREG and QUOTAREG2"
1442              EQ14A(DOMJ, DOMI)       "milk price co-movements between trading regions"
1443              EQ14B(DOMJ, DOMI)       "milk price co-movements between trading regions"
1444              EQ14AQU(DOMJ, DOMI)     "EQ14A for MODELS QUOTAREG and QUOTAREG2"
1445              EQ14BQU(DOMJ, DOMI)     "EQ14B for MODEL QUOTAREG2"
1446              EQ14ATRC(DOMJ, DOMI)    "EQ14A for MODEL MILKTRADECOST"
1447              EQ14BTRC(DOMJ, DOMI)    "EQ14B for MODEL MILKTRADECOST"
1448              EQ15(DOMI)              "milk price and crop price relationship"
1449              EQ16(DOMI)              "demand for silage"
1450              EQ17(DOMI)              "definition of feed crop price index"
1451              EQ18(DOMI, L)           "crop price and land rent relationship"
1452              EQ19(DOMI, SUBSUBL)     "feed crop price change equal to one for SUBSUBL crops"
1453              EQ20(DOMI, L)           "crop supply"
1454              EQ21                    "objective function"
1455              EQ22                    "domestic consumer surplus (objective for MODELS BETTERWEDGESREG and QUOTAREG/QUOTAREG2)"
1456              EQ23(DOMI)              "regional land rents preserved"
1457              EQ24(DOMI)              "sum of regional land rents and regional quota value unchanged (for MODEL QUOTAREG/QUOTAREG2)"
1458              EQ25                    "aggregate land rent transfer (objective for MODEL BETTERSUPPORT)"
1459              EQ26                    "domestic consumer surplus preserved"
1460              ;
1461   
1462  EQ1(I, DOMJ, N)..       C(I, DOMJ, N)       =E= PINDEX1(DOMJ) ** (KAPPA - EPSILON) * PINDEX2(DOMJ, N) ** (SIGMA(N) - KAPPA) * P(I, N) ** (-SIGMA(N)) ;
1463  EQ2(DOMI, SUBN)..       C0(DOMI, SUBN)      =E= PINDEX10 ** (KAPPA0 - EPSILON0) * PINDEX20(SUBN) ** (SIGMA0(SUBN) - KAPPA0) * P(DOMI,SUBN) ** (-SIGMA0(SUBN)) ;
1464  EQ3(DOMJ)..             PINDEX1(DOMJ)       =E= sum(N, B2(DOMJ, N) * (PINDEX2(DOMJ, N)) ** (1 - KAPPA)) ** (1 / (1 - KAPPA)) ;
1465  EQ4(DOMJ, N)..          PINDEX2(DOMJ, N)    =E= sum(I, B3(I, DOMJ, N) * (P(I, N)) ** (1 - SIGMA(N))) ** (1 / (1 - SIGMA(N))) ;
1466  EQ5..                   PINDEX10            =E= sum(SUBN, B2("ROW", SUBN) * (PINDEX20(SUBN) ** (1 - KAPPA0))) ** (1 / (1 - KAPPA0)) ;
1467  EQ6(SUBN)..             PINDEX20(SUBN)      =E= sum(DOMI, B3(DOMI, "ROW", SUBN) * (P(DOMI, SUBN)) ** (1 - SIGMA0(SUBN))) ** (1 / (1 - SIGMA0(SUBN))) ;
1468  EQ7(DOMI, N)..          Q(DOMI, N)          =E= sum(DOMJ, A3(DOMI, DOMJ, N) * C(DOMI, DOMJ, N)) + A3(DOMI, "ROW", N) * C0(DOMI, N) ;
1469  EQ8(DOMI, N, K)..       Z(DOMI, N, K)       =E= Q(DOMI, N) * VINDEX(DOMI, N) ** VARSIGMA(N) * (DELTAHAT(DOMI, N, K) * V(DOMI, K)) ** (- VARSIGMA(N)) ;
1470  EQ9(DOMI, N)..          VINDEX(DOMI, N)     =E= sum(K, C3(DOMI, N, K) * (DELTAHAT(DOMI, N, K) * V(DOMI, K)) ** (1 - VARSIGMA(N))) ** (1 / (1 - VARSIGMA(N))) ;
1471   
1472  EQ10(DOMI, N)..         P(DOMI, N)          =E= PSI2(DOMI, N) * VINDEX(DOMI, N) + 1 - PSI2(DOMI, N) ;
1473   
1474  EQ10EX(DOMI, N)..       P(DOMI, N)          =E= PSI2(DOMI, N) * VINDEXEX(DOMI, N) + 1 - PSI2(DOMI, N) ;
1475   
1476  EQ11(DOMI)..            MQUANT(DOMI)        =E= sum(DOMJ, A(DOMI, DOMJ) * MSHIP(DOMI, DOMJ)) ;
1477  EQ11TRC(DOMI)..         MQUANT(DOMI)        =E= sum(DOMJ, A(DOMI, DOMJ) * TAU(DOMI, DOMJ) * MSHIP(DOMI, DOMJ)) ;
1478   
1479  EQ12(DOMI, K)..         sum(N, CHI(DOMI, N, K) * Z(DOMI, N, K)) =E= sum(DOMJ, MU2(DOMJ, DOMI) * MSHIP(DOMJ, DOMI)) ;
1480   
1481  EQ13(DOMI)..            MPRICE(DOMI) * sum(DOMJ, MU2(DOMJ, DOMI) * MSHIP(DOMJ, DOMI))  =E=  sum(K, THETA2(DOMI, K) * V(DOMI, K) * sum(N, THETA3(DOMI, N, K) * DELTAHAT(DOMI, N, K) * Z(DOMI, N, K))) ;
1482  EQ14A(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..      0 =E= MSHIP(DOMJ, DOMI) * (MPRICE(DOMI) - MPRICE(DOMJ)) ;
1483  EQ14B(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..      MPRICE(DOMI)  =L= MPRICE(DOMJ) ;
1484   
1485  EQ14ATRC(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..   0 =E= MSHIP(DOMJ, DOMI) * (MPRICE(DOMI) - TAU(DOMJ, DOMI) * MPRICE(DOMJ)) ;
1486  EQ14BTRC(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..   MPRICE(DOMI)  =L= TAU(DOMJ, DOMI) * MPRICE(DOMJ) ;
1487   
1488  EQ13QU(DOMI)..          MMPRICE(DOMI) * sum(DOMJ, MU2(DOMJ, DOMI) * MSHIP(DOMJ, DOMI))  =E= sum(K, THETA2(DOMI, K) * V(DOMI, K) * sum(N, THETA3(DOMI, N, K) * DELTAHAT(DOMI, N, K) * Z(DOMI, N, K))) ;
1489  EQ14AQU(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..   0 =E= MSHIP(DOMJ, DOMI) * (MMPRICE(DOMI) - MMPRICE(DOMJ)) ;
1490  EQ14BQU(DOMJ, DOMI)$(MU2(DOMJ, DOMI)>0)..   MMPRICE(DOMI)  =L= MMPRICE(DOMJ) ;
1491   
1492  EQ8OPT(DOMI, N, K)..    Z(DOMI, N, K)       =E= Q(DOMI, N) * VINDEX(DOMI, N) ** VARSIGMA(N) * (DELTAHATOPT(DOMI, N, K) * V(DOMI, K)) ** (- VARSIGMA(N)) ;
1493  EQ9OPT(DOMI, N)..       VINDEX(DOMI, N)     =E= sum(K, C3(DOMI, N, K) * (DELTAHATOPT(DOMI, N, K) * V(DOMI, K)) ** (1 - VARSIGMA(N))) ** (1 / (1 - VARSIGMA(N))) ;
1494  EQ13OPT(DOMI)..         MPRICE(DOMI) * sum(DOMJ, MU2(DOMJ, DOMI) * MSHIP(DOMJ, DOMI))  =E= sum(K, THETA2(DOMI, K) * V(DOMI, K) * sum(N, THETA3(DOMI, N, K) * DELTAHATOPT(DOMI, N, K) * Z(DOMI, N, K))) ;
1495   
1496  EQ15(DOMI)..            MPRICE(DOMI)        =E= PHI1(DOMI) * WINDEX1(DOMI) + 1 - PHI1(DOMI) ;
1497   
1498  EQ16(DOMI)..            Y(DOMI, "SILAGE")   =E= MQUANT(DOMI) * WINDEX1(DOMI) ** RHO * W(DOMI, "SILAGE") ** (- RHO) ;
1499   
1500  EQ17(DOMI)..            WINDEX1(DOMI)       =E= (XI2(DOMI, "SILAGE") * W(DOMI, "SILAGE") ** (1 - RHO) + 1 - XI2(DOMI, "SILAGE")) ** (1 / (1 - RHO)) ;
1501   
1502  EQ18(DOMI, L)..         W(DOMI, L)          =E= VARPHI2(DOMI, L) * R(DOMI, L) + 1 - VARPHI2(DOMI, L) ;
1503   
1504  EQ19(DOMI, SUBSUBL)..   W(DOMI, SUBSUBL)    =E= 1 ;
1505   
1506  EQ20(DOMI, L)..         Y(DOMI, L)          =E= R(DOMI, L) ** (THETA - 1) / sum(M, PI(DOMI, M) * R(DOMI, M) ** THETA) ** ((THETA - 1) / THETA) ;
1507   
1508  EQ21..                  OBJ                 =E=  1 ;
1509   
1510  EQ22..                  DOMCONSSURP         =E= [sum(DOMI, B1(DOMI) * (1 - PINDEX1(DOMI) ** (1 - EPSILON)) ) / (1 - EPSILON) ] * 1E6  ;
1511   
1512  EQ23(DOMI)..            0                   =L=  A0 * PSI * PHI0 / (1 - XI1("ROW")) * RHO1(DOMI) / (1 - RHO0) * sum(L, VARPHI2(DOMI, L) * RHO2(DOMI, L) * (R(DOMI, L) * Y(DOMI, L) - 1))   ;
1513   
1514  EQ24(DOMI)..            0                   =L=  A0 * PSI * PHI0 / (1 - XI1("ROW")) * RHO1(DOMI) / (1 - RHO0) * sum(L, VARPHI2(DOMI, L) * RHO2(DOMI, L) * (R(DOMI, L) * Y(DOMI, L) - 1)) +
1515                                                   A0 * PSI * PHI0 / (1 - XI1("ROW")) * XI1(DOMI) / PHI1(DOMI) * (MMPRICE(DOMI) - MPRICE(DOMI)) * MQUANT(DOMI) ;
1516   
1517  EQ25..                 TRANSFER             =L= sum(DOMI,  RHO1(DOMI) / sum(DOMJ, RHO1(DOMJ) * VARPHI1(DOMJ)) * sum(L, VARPHI2(DOMI, L) * RHO2(DOMI, L) * (R(DOMI, L) * Y(DOMI, L) - 1))) ;
1518  EQ26..                 0                    =L= sum(DOMI, B1(DOMI) * (1 - PINDEX1(DOMI) ** (1 - EPSILON)) )    ;
1519   
1520  * Non-negativity constraints
1521  V.LO(DOMI, K) = 0.001 ;
1522  P.LO(I, N) = 0 ;
1523  MSHIP.LO(DOMI, DOMJ) = 0 ;
1524  MPRICE.LO(DOMI) = 0 ;
1525  R.LO(DOMI, L) = 0 ;
1526  W.LO(DOMI, SUBL) = 0 ;
1527   
1528  PINDEX2.LO(DOMI, N) = 0 ;
1529  PINDEX1.LO(DOMI) = 0 ;
1530  PINDEX20.LO(SUBN) = 0 ;
1531  PINDEX10.LO = 0 ;
1532  WINDEX1.LO(DOMI) = 0 ;
1533  VINDEX.LO(DOMI, N) = 0 ;
1534   
1535  DELTAHATOPT.LO(DOMI, N, K) = 0.0001 ;
1536  MMPRICE.LO(DOMI) = 0 ;
1537   
1538  * Fixed Values To Close the Model
1539  P.FX("ROW", N) = 1 ;
1540  W.FX(DOMI,"Other-Crops") = 1 ;
1541  MSHIP.FX(DOMI, DOMJ)$(MU2(DOMI, DOMJ) = 0) = 1 ;
1542  C0.FX(DOMI, "Beverage") = 1 ;
1543  DELTAHATOPT.FX(DOMI, "Butter-Powder", K) = 1 ;
1544   
1545   
1546  *parameters that are used to generate tables after model runs
1547  parameters MUTILDE(DOMI)                 "share of regional milk use in total milk use (in value)"
1548             DELTAMILKVAL(DOMI)            "change in regional milk production value"
1549             DELTAMILKVALTOT               "change in total milk production value"
1550             DELTAMILKPRICE(DOMI)          "change in regional milk price"
1551             DELTAMILKPRICETOT             "change in aggregate milk price (uses baseline milk quantity data)"
1552             DELTAMILKPROD(DOMI)           "change in regional quantity of milk produced"
1553             DELTAMILKPRODTOT              "change in total quantity of milk produced (uses baseline milk quantity data)"
1554             DELTAMILKUSE(DOMI)            "change in regional quantity of milk used"
1555             DELTAMILKUSETOT               "change in total quantity of milk used (uses baseline milk quantity data)"
1556             MILKPRODSHARESHIP(DOMI)       "regional share of milk production shipped out in baseline"
1557             MILKPRODSHARESHIPPRIME(DOMI)  "regional share of milk production shipped out in counterfactual"
1558             DELTAMILKPRODSHARESHIP(DOMI)  "change in regional share of milk production shipped out"
1559             MILKPRODSHARESHIPTOT          "total share of milk produced that is shipped out in baseline"
1560             MILKPRODSHARESHIPTOTPRIME     "total share of milk produced that is shipped out in counterfactual"
1561             DELTAMILKPRODSHARESHIPTOT     "change in total share of milk production shipped out"
1562             MILKUSESHARESHIP(DOMI)        "regional share of milk use shipped in in baseline"
1563             MILKUSESHARESHIPPRIME(DOMI)   "regional share of milk use shipped in in counterfactual"
1564             DELTAMILKUSESHARESHIP(DOMI)   "change in regional share of milk use shipped in"
1565             ;
1566   
1567  MUTILDE(DOMI) = sum(DOMJ, MU1(DOMJ) * A(DOMJ, DOMI)) ;
1568  MILKPRODSHARESHIP(DOMI) = 1 - A(DOMI, DOMI) - 1 / MU1(DOMI) * sum(DOMJ$(ORD(DOMJ) NE ORD(DOMI)), MU2(DOMJ, DOMI) * MUTILDE(DOMI)) ;
1569  MILKPRODSHARESHIPTOT = sum(DOMI$(MILKPRODSHARESHIP(DOMI) > 0), MU1(DOMI) * MILKPRODSHARESHIP(DOMI)) ;
1570  MILKUSESHARESHIP(DOMI) = 1 - MU2(DOMI, DOMI) - 1 / MUTILDE(DOMI) * sum(DOMJ$(ORD(DOMJ) NE ORD(DOMI)), MU1(DOMI) * A(DOMI, DOMJ))   ;
1571   
1572   
1573  parameters    DAIRYQUANT(DOMI, N)    "regional change in dairy product quantity produced"
1574                DAIRYVAL(DOMI)         "regional change in total dairy product value"
1575                DAIRYVALTOT            "aggregate change in total dairy product value"
1576                DAIRYEXP(DOMI)         "regional change in dairy export value"
1577                DAIRYEXPSHARE(DOMI)    "regional share of total US dairy exports"
1578                DAIRYEXPTOT            "total change in dairy export value"
1579                ;
1580   
1581  parameters       CS(DOMI)        "regional change in consumer surplus relative to regional consumption value"
1582                   CSDOM           "domestic change in consumer surplus relative to domestic consumption value"
1583                   CSFOR           "foreign change in consumer surplus relative to foreign consumption value"
1584                   CSTOT           "change in total consumer surplus relative to total consumption value"
1585                   PS(DOMI)        "relative change in regional land rents"
1586                   PSDOM           "relative change in domestic land rents"
1587                   PSTOT           "change in domestic land rents relative to total consumption value"
1588                   WELF(DOMI)      "change in regional welfare relative to total consumption value"
1589                   WELFDOM         "change in domestic welfare relative to total consumption value"
1590                   WELFFOR         "change in foreign welfare relative to total consumption value"
1591                   WELFTOT         "change in total welfare relative to total consumption value"
1592                   PC              "total value of dairy consumption"
1593                   CSVAL(DOMI)     "change in regional consumer surplus in USD"
1594                   CSDOMVAL        "change in domestic consumer surplus in USD"
1595                   CSFORVAL        "change in foreign consumer surplus in USD"
1596                   CSTOTVAL        "change in total consumer surplus in USD"
1597                   PSVAL(DOMI)     "change in regional land rents in USD"
1598                   PSDOMVAL        "chnage in domestic land rents in USD"
1599                   WELFVAL(DOMI)   "change in regional welfare in USD"
1600                   WELFDOMVAL      "change in domestic welfare in USD"
1601                   WELFTOTVAL      "change in total welfare in USD"
1602                   ;
1603   
1604   
1605  *************************************************************
1606  ********(0) DERIVATION OF SELECTED MODEL ELASTICITIES********
1607  *************************************************************
1608  **THIS PART OF THE CODE GENERATES THE VALUES REPORTED
1609  *IN TABLE 1 OF SECTION 5 AND TABLES D.1-D.4 OF THE SUPPLEMENTAL APPENDIX
1610  *THIS PART OF THE CODE ALSO SUBSTANTIATES THE CLAIM THAT THE SHARE OF FARM MILK IN TOTAL DAIRY PRODUCT VALUE IS 18% (SECTION 1)
1611   
1613   
1614  ***************************************************
1615  *(0.1) REGIONAL MILK SUPPLY ELASTICITIES (TABLE 1)
1616   
1618   
1619  *************************************************************
1620  *(0.2) REGIONAL DAIRY PRODUCT DEMAND ELASTICITIES (TABLE D.1)
1621   
1623   
1624  **************************************************************
1625  *(0.5) REGIONAL MILK COMPONENT DEMAND ELASTICITIES (TABLE D.4)
1626   
1627  MODEL COMPDEMAND /EQ1,EQ2,EQ3,EQ4,EQ5,EQ6,EQ7,EQ10EX,EQ21/ ;
1628   
1630   
1631  *************************************************************
1632  ****(1) COUNTERFACTUAL REMOVAL OF FMMO COMPONENT WEDGES******
1633  *************************************************************
1634  **THIS PART OF THE CODE PROVIDES THE VALUES REPORTED IN TABLES 2-6 AND THOSE REPORTED IN
1635  *TABLE E.1 (SENSITIVITY ANALYSIS)
1636  *IT ALSO PROVIDES SUPPORT FOR SOME OF THE NUMBERS REPORTED IN SECTION 1 THAT ARE DIRECTLY
1637  *TAKEN FROM THESE TABLES, NOTABLY REGARDING WELFARE EFFECTS OF FMMO REMOVAL
1638   
1639  ***********************************************
1640  *(1.1) EXTRACT WEDGE PARAMETERS (FOR TABLE 2)
1641   
1643   
1644  ********************************************************************
1645  **THEN RUN MAIN COUNTERFACTUAL WITH BASELINE SHAPE PARAMETER VALUES
1646  ********************************************************************
1647   
1648  MODEL FMMO /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8, EQ9, EQ10, EQ11, EQ12, EQ13, EQ14A, EQ14B, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ21/ ;
1649   
1651   
1652   
1653  ************************************************
1654  *(1.6) SENSITIVITY ANALYSIS (TABLE E.1)
1655   
1656  ****THIS CODE RUNS THE 7 SCENARIOS IN TABLE E.1, AND ADDITIONAL SCENARIOS TO SUPPORT THE CLAIM IN SECTION 6.5 THAT
1657  *VARSIGMA^CHEESE IS THE MOST CRITICAL SUBSTITUTION ELASTICITY AMONG DAIRY PRODUCTS
1658   
1660   
1661   
1662  ******************************************************************
1663  ***(2) COUNTERFACTUAL OPTIMAL WEDGLES (FIRST COLUMN OF TABLE 7)***
1664  ******************************************************************
1665   
1666  MODEL BETTERWEDGESREG /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8OPT, EQ9OPT, EQ10, EQ11, EQ12, EQ13OPT, EQ14A, EQ14B, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ22, EQ23 / ;
1667  *THIS MODEL IMPROVES ON THE BASELINE BY MAXIMIZING DOMESTIC CONS SURPLUS SUBJ TO NO HARM TO REGIONAL LAND RENT
1668   
1670   
1671   
1672  ************************************************************************
1673  ***(3) COUNTERFACTUAL REGIONAL MILK QUOTAS (SECOND COLUMN OF TABLE 7)***
1674  ************************************************************************
1675   
1676  MODEL QUOTAREG /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8, EQ9, EQ10, EQ11, EQ12, EQ13QU, EQ14AQU, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ22, EQ24 / ;
1677  *THIS MODEL USES A DAIRY QUOTA TO SUSTAIN THE SUM OF LAND RENTS AND DAIRY QUOTA RENTS AT REGIONAL LEVEL
1678   
1679   
1680  * Starting Values
1681  P.L(DOMI, N) = 1 ;
1682  PINDEX2.L(DOMI, N) = 1 ;
1683  PINDEX1.L(DOMI) = 1 ;
1684  PINDEX20.L(SUBN) = 1 ;
1685  PINDEX10.L = 1 ;
1686  C.L(I, DOMJ, N) = 1 ;
1687  C0.L(DOMI, SUBN) = 1 ;
1688  Q.L(DOMI, N) = 1 ;
1689  V.L(DOMI, K) = 1 ;
1690  VINDEX.L(DOMI, N) = 1 ;
1691  Z.L(DOMI, N, K) = 1 ;
1692  R.L(DOMI, L) = 1 ;
1693  W.L(DOMI, L) = 1 ;
1694  WINDEX1.L(DOMI) = 1 ;
1695  MSHIP.L(DOMI, DOMJ) = 1 ;
1696  MQUANT.L(DOMI) = 1 ;
1697  MPRICE.L(DOMI) = 1 ;
1698  Y.L(DOMI, L) = 1 ;
1699   
1700  MMPRICE.L(DOMI) = 1 ;
1701   
1703   
1704  *************************************************************
1705  ******(4) COUNTERFACTUAL INCREASE IN MILK TRADE COSTS********
1706  *************************************************************
1707   
1708  *THIS PROGRAM SUBSTANTIATES CLAIMS REGARDING COUNTERFACTUAL INCREASES IN MILK TRADE COSTS
1709  *MADE IN SECTION 1 AND IN SECTION 6.1
1710   
1711  MODEL MILKTRADECOST /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8, EQ9, EQ10, EQ11TRC, EQ12, EQ13, EQ14ATRC, EQ14BTRC, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ21/ ;
1712  *THIS MODEL INCREASES MILK TRADE COSTS UNIFORMLY UNTIL ALL TRADE IN FARM MILK DISAPPEARS
1713  *THE FOLLOWING ITERATIONS OF THE MODEL DEMONSTRATE THAT A SMALL MILK TRADE FLOW EXISTS AT TAU(DOMI, DOMJ) = 1.75 YET DISAPPEARS AT TAU(DOMI, DOMJ) = 1.76
1714  *TRADE IS ASSUMED TO DISAPPEAR IF THE PARAMETER DELTAMILKPRODSHARESHIPTOT IS EQUAL TO THE NEGATIVE OF MILKPRODSHARESHIPTOT (ITS BASELINE VALUE)
1715   
1717   
1718   
1719  ********************************************************************
1720  ***(5) MAXIMUM TRANSFER THAT PRESERVES DOMESTIC CONSUMER SURPLUS****
1721  ********************************************************************
1722   
1723  *THIS PROGRAM SUBSTANTIATES THE CLAIM MADE IN SECTION 6.6 REGARDING THE POSSIBILITY TO
1724  *INCREASE THE LAND RENT TRANSFER WHITHOUT HURTING DOMESTIC CONSUMERS VIA CHANGES IN COMPONENT WEDGES
1725   
1726  MODEL BETTERSUPPORT /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8OPT, EQ9OPT, EQ10, EQ11, EQ12, EQ13OPT, EQ14A, EQ14B, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ25, EQ23, EQ26 / ;
1727  *THIS PROGRAM RESHUFFLES COMPONENT PRICE WEDGES TO MAXIMIZE AGGREGATE LAND RENTS SUBJECT TO NO HARM TO CONSUMERS OR TO ANY REGIONAL
1728  *LAND RENT RELATIVE TO BASELINE
1729   
1731   
1732  ****************************************************************************************
1733  *************(6) ALTERNATIVE POLICY COMPARISON WITH EPSILON0=100************************
1734  ****************************************************************************************
1735   
1736  *THIS PART OF THE CODE SUBSTANTIATES THE CONTENTS OF FOOTNOTE 25
1737   
1739   
1740   
1741  ****************************************************************************************
1742  *************(7) REGIONAL MILK QUOTAS WITH FULL ARBITRAGE CONDITION*********************
1743  ****************************************************************************************
1744  *THIS PART OF THE CODE SUBSTANTIATES THE CLAIM MADE IN APPENDIX F.3 THAT IF ONE KEEPS
1745  *ALL THE CONDITIONS IN EQUATION (19), THEN THE REGIONAL LAND RENT CONSTRAINT BECOMES NON-BINDING
1746  *IN SOME MILK EXPORTING REGIONS, REDUCING THE VALUE OF DOMESTIC CONSUMER SURPLUS THAT CAN BE ACHIEVED.
1747   
1748  MODEL QUOTAREGALT /EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7, EQ8, EQ9, EQ10, EQ11, EQ12, EQ13QU, EQ14AQU, EQ14BQU, EQ15, EQ16, EQ17, EQ18, EQ19, EQ20, EQ22, EQ24 / ;
1749   
1751   
1752   
1753  ****************************************************************************************
1754  ***(8) AGGREGATE COMPONENT DEMAND ELASTICITIES FOR USE IN BEVERAGE AND OTHER PRODUCTS***
1755  ****************************************************************************************
1756  *THIS PART OF THE CODE SUBSTANTIATES THE VALUES OF EPSILON1 (0.1) AND EPSILON2 (0.3)
1757  *USED IN APPENDIX G
1758  *IT ALSO SUBSTANTIATES THE CLAIM THAT THE VALUE SHARE OF BEVERAGE PRODUCTS IN THE TOTAL VALUE OF DAIRY PRODUCTS IS 19.4% (APPENDIX G.1)
1759  *IT ALSO RECOMPUTES THE DERIVED DEMAND ELASTICITY FOR MANUFACTURED PRODUCTS WHEN SETTING EPSILON_0 EQUAL TO 100
1760  *AND CONFIRMS THAT THE SHARE OF FOREIGN IN TOTAL CONSUMPTION OF MANUFACTURED PRODUCTS OF US ORIGIN IS 3.6% (APPENDIX G.2)
1761  *NOTE: TO AGGREGATE COMPONENT DEMAND ACROSS REGIONS GIVEN DIFFERENTIATED DAIRY PRODUCTS BY ORIGIN, THE RELATIVE CHANGE IN THE AGGREGATE VALUE (NOT QUANTITY) OF COMPONENTS
1762  *IS COMPUTED, AND WE SUBTRACT 1 TO THE ELASTICITY OF AGGREGATE VALUE W.R.T. TO THE COMMON PRICE INCREASE TO TURN THE VALUE
1763  *ELASTICITY BACK INTO A QUANTITY ELASTICITY
1764   
1766   
1767  parameters ELASCOMPUSEBEV(DOMI)      "elasticity of component demand for use in beverage products"
1768             ELASCOMPUSEMAN(DOMI)      "elasticity of component demand for use in other dairy products"
1769             ELASCOMPUSEBEVTOT         "aggregate elasticity of component demand for use in beverage products"
1770             ELASCOMPUSEMANTOT         "aggregate elasticity of component demand for use in other dairy products"
1771             ELASCOMPUSEMANTOT100      "aggregate elasticity of component demand for use in other dairy products when EPSILON0=100"
1772             SHAREBEV                  "share of component value used in beverage products"
1773             SHAREMANFOR               "share of foreign in value of consumption of non-beverage dairy products"
1774             ;
1775   
1776  VINDEXEX(DOMI , SUBN) = 1 ;
1777  VINDEXEX(DOMI, "beverage") = 1.0001 ;
1778   
1779  * Starting Values
1780    P.L(DOMI, N) = 1 ;
1781    PINDEX2.L(DOMI, N) = 1 ;
1782    PINDEX1.L(DOMI) = 1 ;
1783    PINDEX20.L(SUBN) = 1 ;
1784    PINDEX10.L = 1 ;
1785    C.L(I, DOMJ, N) = 1 ;
1786    C0.L(DOMI, SUBN) = 1 ;
1787    Q.L(DOMI, N) = 1 ;
1788   
1789   
1790  SOLVE COMPDEMAND USING NLP MAXIMIZING OBJ ;
1791  ELASCOMPUSEBEV(DOMI) = ( Q.L(DOMI, "beverage")- 1 ) / ( 1.0001 - 1 ) ;
1792  ELASCOMPUSEBEVTOT = (sum(DOMI, A1(DOMI)*A2(DOMI,"beverage")*PSI2(DOMI,"beverage")/sum(DOMJ, A1(DOMJ)*A2(DOMJ,"beverage")*PSI2(DOMJ,"beverage")) * VINDEXEX(DOMI, "beverage") * Q.L(DOMI, "beverage")) -1 )/0.0001 -1 ;
1793   
1794  VINDEXEX(DOMI, "beverage") = 1 ;
1795  VINDEXEX(DOMI , SUBN) = 1.0001 ;
1796   
1797  * Starting Values
1798    P.L(DOMI, N) = 1 ;
1799    PINDEX2.L(DOMI, N) = 1 ;
1800    PINDEX1.L(DOMI) = 1 ;
1801    PINDEX20.L(SUBN) = 1 ;
1802    PINDEX10.L = 1 ;
1803    C.L(I, DOMJ, N) = 1 ;
1804    C0.L(DOMI, SUBN) = 1 ;
1805    Q.L(DOMI, N) = 1 ;
1806   
1807  SOLVE COMPDEMAND USING NLP MAXIMIZING OBJ ;
1808   
1809  ELASCOMPUSEMAN(DOMI) = ( sum(SUBN, Q.L(DOMI, SUBN) * B2(DOMI, SUBN) /(1 - B2(DOMI, "beverage"))) - 1 ) / ( 1.0001 - 1 ) ;
1810  ELASCOMPUSEMANTOT = (sum((DOMI, SUBN), A1(DOMI)*A2(DOMI,SUBN)*PSI2(DOMI,SUBN)* VINDEXEX(DOMI, SUBN) * Q.L(DOMI,SUBN)) / sum((DOMJ, SUBN), A1(DOMJ)*A2(DOMJ, SUBN)*PSI2(DOMJ, SUBN))  -1 )/0.0001 -1 ;
1811   
1812  SHAREBEV = sum(DOMI, A1(DOMI)*A2(DOMI,"beverage")*PSI2(DOMI,"beverage")) / sum((DOMI, N), A1(DOMI)*A2(DOMI,N)*PSI2(DOMI,N) ) ;
1813   
1814  SHAREMANFOR = sum((SUBN, DOMJ), B1("ROW") * B2("ROW", SUBN) * B3(DOMJ, "ROW", SUBN)) / sum((DOMI, SUBN, DOMJ), B1(DOMI) * B2(DOMI, SUBN) * B3(DOMJ, DOMI, SUBN)) ;
1815   
1816  EPSILON0 = 100 ;
1817  * Starting Values
1818    P.L(DOMI, N) = 1 ;
1819    PINDEX2.L(DOMI, N) = 1 ;
1820    PINDEX1.L(DOMI) = 1 ;
1821    PINDEX20.L(SUBN) = 1 ;
1822    PINDEX10.L = 1 ;
1823    C.L(I, DOMJ, N) = 1 ;
1824    C0.L(DOMI, SUBN) = 1 ;
1825    Q.L(DOMI, N) = 1 ;
1826   
1827  SOLVE COMPDEMAND USING NLP MAXIMIZING OBJ ;
1828   
1829  ELASCOMPUSEMANTOT100 = (sum((DOMI, SUBN), A1(DOMI)*A2(DOMI,SUBN)*PSI2(DOMI,SUBN)* VINDEXEX(DOMI, SUBN) * Q.L(DOMI,SUBN)) / sum((DOMJ, SUBN), A1(DOMJ)*A2(DOMJ, SUBN)*PSI2(DOMJ, SUBN))  -1 )/0.0001 -1 ;
1830   
1831   
