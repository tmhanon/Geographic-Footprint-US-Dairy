GAMS 54.2.1  d9889eb3 Jul 13, 2026          DAX-DAC arm 64bit/macOS - 08/12/26 09:47:57 Page 1
GAMS CODE FOR "THE GEOGRAPHIC FOOTPRINT OF U.S. DAIRY POLICY," QUANTITATIVE ECONOMICS
C o m p i l a t i o n


   2  *THIS FILE RUNS SEVERAL COUNTERFACTUAL MODELS:
   3  *(1) REMOVAL OF FMMO PRICE DISTORTIONS (MODEL FMMO)
   4  *(2) IDEAL COMPONENT WEDGES THAT MAXIMIZE DOMESTIC CONSUMER SURPLUS WHILE PRESERVING REGIONAL LAND RENTS (MODEL BETTERWEDGESREG)
   5  *(3) REGIONAL MILK QUOTAS THAT MAXIMIZE DOMESTIC CONSUMER SURPLUS WHILE PRESERVING REGIONAL LAND + QUOTA RENTS (MODEL QUOTAREG)
   6  *(4) INCREASE OF FARM MILK TRADE COSTS UNTIL FARM MILK TRADE VANISHES (MODEL MILKTRADECOST)
   7  *(5) COMPONENT WEDGES RESHUFFLING TO INCREASE DOMESTIC LAND RENT TRANSFERS WITHOUT HURTING DOMESTIC CONSUMERS (MODEL BETTERSUPPORT)
   8  *(6) COMPARISON BETWEEN OPTIMAL WEDGES AND QUOTA WHEN EPSILON0 IS MADE EQUAL TO 100 (VERY ELASTIC FOREIGN DEMAND)
   9  *(7) REGIONAL MILK QUOTAS THAT MAXIMIZE DOMESTIC CONSUMER SURPLUS WHILE PRESERVING REGIONAL LAND + QUOTA RENTS BUT KEEPING
  10  *THE FULL ARBITRAGE REGARDING FARM MILK TRADE (MODEL QUOTAREG2)
  11  *(8) SIMULTANEOUS CHANGES IN COMPONENT PRICES TO DERIVE AGGREGATE COMPONENT DEMAND ELASTICITIES FOR BEVERAGE AND OTHER PRODUCTS (MODEL COMPDEMAND) SUPPORTING CLAIMS MADE IN APPENDIX G
  12  *(0) IN ADDITION, PARAMETER CALCULATIONS OR MODEL EQUATIONS ARE USED TO DERIVE KEY MODEL ELASTICITIES AS REPORTED IN SECTION 5 AND SUPPLEMENTAL APPENDIX D
  13   
  14  *THIS FILE HAS MANY SECTIONS. THE FILE SHOULD BE RUN SEPARATELY FOR EACH SECTION. THE USER SHOULD UNCOMMENT THE CODE LOCATED BETWEEN EACH PAIR ($ONTEXT, $OFFTEXT),
  15  *ONE PAIR AT A TIME.
  16   
  17  *THIS CODE WAS TESTED USING GAMS STUDIO 1.25.5 ON A 14-INCH 2021 APPLE MACBOOKPRO WITH APPLE M1 CHIP and 32GB OF MEMORY, RUNNING MACOS SONOMA 14.7
  18   
  19  ** SET OPTIONS
  20   
  21  option nlp = conopt3 ;
  22  option decimals = 8;
  23   
  24  ** DEFINE SETS, SCALARS, AND PARAMETERS
  25   
  26  sets        I           all regions         /Northeast, Appalachian, Florida, Southeast, Upper-Midwest, Central, Mideast, California, Pacific-Northwest, Southwest, Arizona, Unregulated, ROW/
  27              DOMI(I)     domestic regions    /Northeast, Appalachian, Florida, Southeast, Upper-Midwest, Central, Mideast, California, Pacific-Northwest, Southwest, Arizona, Unregulated/
  28   
  29              N           products            /Beverage, Softs, Cheese, Butter-Powder/
  30              SUBN(N)                         /Softs, Cheese, Butter-Powder/
  31   
  32              K           components          /Fat, Protein, Other-Solids/
  33   
  34              L           crops               /Grains, Oilseeds, Hay, Silage, Other-Crops /
  35              SUBL(L)                         /Grains, Oilseeds, Hay, Silage/
  36              SUBSUBL(SUBL)                   /Grains, Oilseeds, Hay/
  37              ;
  38   
  39  alias       (I, J)
  40              (DOMI, DOMJ, DOMII)
  41              (L, M)
  42              (SUBL, SUBM)
  43              (SUBSUBL, SUBSUBM)
  44              (N, O)
  45              (K, S)
  46              ;
  47   
  48  scalars     EPSILON         "absolute value of dairy product demand elasticity, 0 < e < 1"          /0.2/
  49              EPSILON0        "absolute value of foreign dairy product demand elasticity"             /1.3/
  50              KAPPA           "elasticity of substitution between dairy products, k > e"              /0.5/
  51              KAPPA0          "foreign elasticity of substitution between dairy products"             /1.8/
  52              RHO             "elasticity of substitution across feed crops, r > 0"                   /0.2/
  53              THETA           "heterogeneity parameter, > 1"                                          /1.05/
  54              ;
  55   
  56  parameters
  57  SIGMA(N) "elasticity of substitution between dairy product n origin regions, > 0"
  58      /   beverage        2.5
  59          softs           4
  60          cheese          4
  61          butter-powder   7 /
  62   
  63  SIGMA0(SUBN) "foreign elasticity of substitution between dairy product n origins, >0"
  64      /   softs           8
  65          cheese          8
  66          butter-powder   10 /
  67   
  68   
  69  VARSIGMA(N) "elasticity of substitution between components used in product n, > 0"
  70      /   beverage        0.3
  71          softs           0.8
  72          cheese          0.2
  73          butter-powder   0.2 /
  74  ;
  75   
  76   
  77  ** IMPORT CSV DATA
  78   
  79  **dairy products
  80  parameter   VALPRODSHIP(I, J, N)    "value of shipments of product N from region I to region J"
  81  /
