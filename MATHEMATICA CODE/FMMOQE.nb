Cell[BoxData[
 RowBox[{
  RowBox[{"ConsSurpluswedge", "[", 
   RowBox[{
   "tau_", ",", "sigma_", ",", "epsilon1_", ",", "epsilon2_", ",", "eta_"}], 
   "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "sigma"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"tau1", "/.", 
           RowBox[{"FindTaus", "[", 
            RowBox[{
            "tau", ",", "sigma", ",", "epsilon1", ",", "epsilon2", ",", 
             "eta"}], "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "-", "epsilon1"}], ")"}]}], "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "epsilon1"}], ")"}]}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "sigma"}], ")"}], "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"tau2", "/.", 
           RowBox[{"FindTaus", "[", 
            RowBox[{
            "tau", ",", "sigma", ",", "epsilon1", ",", "epsilon2", ",", 
             "eta"}], "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "-", "epsilon2"}], ")"}]}], "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "epsilon2"}], ")"}]}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.985958381538659*^9, 3.985958411891053*^9}, {
