Cell[BoxData[
 RowBox[{
  RowBox[{"FindTauq", "[", 
   RowBox[{
   "tau_", ",", "sigma_", ",", "epsilon1_", ",", "epsilon2_", ",", "eta_"}], 
   "]"}], ":=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"sigma", "*", 
        RowBox[{"tauq", "^", 
         RowBox[{"(", 
          RowBox[{"1", "-", "epsilon1"}], ")"}]}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "sigma"}], ")"}], "*", 
        RowBox[{"tauq", "^", 
         RowBox[{"(", 
          RowBox[{"1", "-", "epsilon2"}], ")"}]}]}], "-", 
       RowBox[{
        RowBox[{"eta", "/", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eta"}], ")"}]}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sigma", "*", 
            RowBox[{"tauq", "^", 
             RowBox[{"(", 
              RowBox[{"-", "epsilon1"}], ")"}]}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "sigma"}], ")"}], "*", 
            RowBox[{"tauq", "^", 
             RowBox[{"(", 
              RowBox[{"-", "epsilon2"}], ")"}]}]}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"1", "/", "eta"}]}], ")"}]}]}]}], "\[Equal]", 
      RowBox[{
       RowBox[{"tau", "^", 
        RowBox[{"(", 
         RowBox[{"1", "+", "eta"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "eta"}], ")"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"tauq", ",", "1"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"02f0ac2e-b16f-44e3-b11b-ce1ddeb8d4ea"],

