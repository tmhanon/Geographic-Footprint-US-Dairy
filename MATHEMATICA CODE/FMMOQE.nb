Cell[BoxData[
 RowBox[{
  RowBox[{"FindTaus", "[", 
   RowBox[{
   "tau_", ",", "sigma_", ",", "epsilon1_", ",", "epsilon2_", ",", "eta_"}], 
   "]"}], ":=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"sigma", "*", 
         RowBox[{"tau1", "^", 
          RowBox[{"(", 
           RowBox[{"-", "epsilon1"}], ")"}]}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "sigma"}], ")"}], "*", 
         RowBox[{"tau2", "^", 
          RowBox[{"(", 
           RowBox[{"-", "epsilon2"}], ")"}]}]}]}], "\[Equal]", 
       RowBox[{"tau", "^", "eta"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"sigma", "*", 
         RowBox[{"tau1", "^", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsilon1"}], ")"}]}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "sigma"}], ")"}], "*", 
         RowBox[{"tau2", "^", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsilon2"}], ")"}]}]}]}], "\[Equal]", 
       RowBox[{"tau", "^", 
        RowBox[{"(", 
         RowBox[{"1", "+", "eta"}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"sigma", "*", 
         RowBox[{"tauq", "^", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsilon1"}], ")"}]}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "sigma"}], ")"}], "*", 
         RowBox[{"tauq", "^", 
          RowBox[{"(", 
           RowBox[{"1", "-", "epsilon2"}], ")"}]}]}], "-", 
        RowBox[{
         RowBox[{"eta", "/", 
          RowBox[{"(", 
           RowBox[{"1", "+", "eta"}], ")"}]}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"sigma", "*", 
             RowBox[{"tauq", "^", 
              RowBox[{"(", 
               RowBox[{"-", "epsilon1"}], ")"}]}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "sigma"}], ")"}], "*", 
             RowBox[{"tauq", "^", 
              RowBox[{"(", 
               RowBox[{"-", "epsilon2"}], ")"}]}]}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"1", "/", "eta"}]}], ")"}]}]}]}], "\[Equal]", 
       RowBox[{
        RowBox[{"tau", "^", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eta"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "eta"}], ")"}]}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"tau1", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"tau2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"tauq", ",", "1"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.994426132761791*^9, 3.994426143006102*^9}, 
   3.994426363950632*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"9fe544d4-2673-41af-8001-f4ef45eda4e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DWLwedge", "[", 
   RowBox[{
   "tau_", ",", "sigma_", ",", "epsilon1_", ",", "epsilon2_", ",", "eta_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"tau", "^", 
       RowBox[{"(", 
        RowBox[{"1", "+", "eta"}], ")"}]}], "-", "1"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", "eta"}], ")"}]}], "-", 
   RowBox[{"sigma", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tau1", "/.", 
          RowBox[{"FindTaus", "[", 
           RowBox[{
           "tau", ",", "sigma", ",", "epsilon1", ",", "epsilon2", ",", 
            "eta"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "-", "epsilon1"}], ")"}]}], "-", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", "epsilon1"}], ")"}]}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "sigma"}], ")"}], "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tau2", "/.", 
          RowBox[{"FindTaus", "[", 
           RowBox[{
           "tau", ",", "sigma", ",", "epsilon1", ",", "epsilon2", ",", 
            "eta"}], "]"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "-", "epsilon2"}], ")"}]}], "-", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", "epsilon2"}], ")"}]}]}]}]}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"2c3da537-0350-430f-9dd9-2cb36abfd824"],

